# =====================================================================
# Student Career & Scholarship Portal - Environment Configuration
# =====================================================================
# Copy this template to .env for local development.
# Configure these variables in the Vercel Dashboard for production.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secure-random-secret-key-here-min-32-chars

# Database Configuration
# Local Development (SQLite fallback):
# DATABASE_URL=sqlite:///instance/database.db
# Production (PostgreSQL - Neon / Supabase):
DATABASE_URL=postgresql://user:password@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# Administrator Bootstrap (Idempotent initial admin creation)
ADMIN_EMAIL=admin@portal.com
ADMIN_INITIAL_PASSWORD=YourSecureAdminPassword123!
ADMIN_BOOTSTRAP_SECRET=optional-bootstrap-secret-token

# Security & Session Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Local Server Settings
PORT=5000
HOST=127.0.0.1
